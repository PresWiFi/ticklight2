# Timezone for due dates, energy schedule, reminders (e.g. America/Denver)
TZ=UTC
PORT=8080

# ---- Login ----
# none = no login (trusted LAN only). oidc = log in with Authentik or any OIDC provider.
AUTH_MODE=none
# Public URL, used for the OIDC redirect: <BASE_URL>/auth/callback
BASE_URL=
# Authentik: https://auth.example.com/application/o/<app-slug>/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional: only these groups may log in (comma-separated)
OIDC_ALLOWED_GROUPS=
SESSION_DAYS=90

# ---- AI (optional; without it, captures are sorted by simple rules) ----
OPENROUTER_API_KEY=
# Free models to try in order. Blank = pick from OpenRouter's current free list automatically.
OPENROUTER_FREE_MODELS=
# Cheap paid fallback when free models are rate-limited. Blank = never pay.
OPENROUTER_PAID_MODEL=
# Any OpenAI-compatible server, e.g. Ollama on another PC: http://192.168.1.20:11434/v1
LOCAL_AI_URL=
LOCAL_AI_MODEL=
# Order to try: free, local, paid
AI_ORDER=free,local,paid

# ---- Voice (optional) ----
# Any OpenAI-compatible speech-to-text server, e.g. Speaches on the GPU box (see README)
WHISPER_URL=
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_API_KEY=
# Force a language (e.g. en); blank = auto-detect
WHISPER_LANGUAGE=

# ---- Phone notifications ----
# Contact sent to push services. Blank = BASE_URL.
VAPID_SUBJECT=

# ---- Telegram (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Default morning launch time for new users (HH:MM, blank = off). Change it later in ⚙ → Routines.
SUMMARY_TIME=08:00

# ---- Alexa (optional, see README) ----
ALEXA_SKILL_ID=
# Map Alexa accounts to Ticklight users (amzn1.ask.account.XXX:2). Blank = first user.
ALEXA_USERS=

# ---- Behaviour ----
UPCOMING_DAYS=7
# One-off tasks this many days past their date move to Someday
STALE_OVERDUE_DAYS=7
# Undated tasks untouched this long move to Someday
STALE_UNDATED_DAYS=21
# Default energy by time of day when you haven't set it: HH:level (1 low, 2 medium, 3 high)
ENERGY_SCHEDULE=00:1,09:3,12:2,15:1,18:2,21:1
